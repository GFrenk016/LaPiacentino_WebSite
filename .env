# =============================================================================
# MODALITÀ MANUTENZIONE / LANDING LOCKDOWN
# =============================================================================
# true  -> è visibile SOLO la landing "Richiedi preventivo"; ogni altra rotta
#          reindirizza alla landing (sito completo oscurato)
# false -> sito completo riattivato (tutte le pagine tornano raggiungibili)
#
# Dopo aver modificato questo valore è necessario rifare la build/deploy
# (le variabili VITE_* vengono lette al momento della build).
VITE_MAINTENANCE_MODE=true
